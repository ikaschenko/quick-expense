VITE_GOOGLE_CLIENT_ID=
VITE_EXCHANGE_API_BASE_URL=
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback
FRONTEND_BASE_URL=http://localhost:5173
PORT=3001
# Google API key (Browser API key from Google Cloud Console, with Picker API enabled)
SESSION_SECRET=replace-with-random-secret
GOOGLE_API_KEY=your-google-api-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickexpense
# Posthog analytics (leave blank to disable)
VITE_POSTHOG_KEY=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Test sheets for integration tests (leave blank to disable)
TEST_SHEET_BLANK=
TEST_SHEET_INVALID=
TEST_SHEET_VALID=

# Number of months of recent expense data loaded immediately (Phase 1).
# Older records are fetched in the background after the UI is ready.
# Default: 24 (two full years). Increase for users with very active older data.
EXPENSE_RECENT_MONTHS=24

RESEND_API_KEY=your-resend-api-key
# Sender address for transactional emails. Must match a Resend-verified domain.
# Leave blank to disable email sending entirely.
EMAIL_FROM=QuickExpense <noreply@send.q-expense.com>

# Email(s) allowed to access the /admin-logs.html viewer and admin log API routes.
# Must match the signed-in Google account email. Separate multiple with , or ;
ADMIN_EMAIL=you@example.com

# Comma/semicolon-separated recipient list for error-alert and warning-digest emails.
# Leave blank to disable alert emails entirely (RESEND_API_KEY/EMAIL_FROM still required).
ALERT_EMAIL_TO=you@example.com,other@example.com

# Directory where rotated log files are written. Defaults to a repo-relative "logs/" folder when unset.
LOG_DIR=
# Days to retain rotated log files before winston-daily-rotate-file deletes them.
LOG_RETENTION_DAYS=15
# Once total log directory size exceeds this, oldest files are swept on each rotation.
LOG_MAX_TOTAL_MB=50
# Minimum time between error-alert emails, in milliseconds (throttle).
ALERT_ERROR_THROTTLE_MS=300000
# How often the warning-digest email is sent (only if warnings occurred), in hours.
ALERT_WARNING_DIGEST_INTERVAL_HOURS=24
# Subject line prefix for alert emails.
ALERT_EMAIL_SUBJECT_PREFIX=[QuickExpense Alert]
