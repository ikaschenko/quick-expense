{
    "chat.subagents.allowInvocationsFromSubagents": true,
    "chat.tools.terminal.autoApprove": {
        "/^gh issue view\\b/": true,
        "/^gh issue comment\\b/": true,
        "/^gh pr view\\b/": true,

        "/^git status\\b/": true,
        "/^git fetch\\b/": true,
        "/^git switch\\b/": true,
        "/^git add\\b/i": true,
        "/^git log\\b/i": true,
        "/^git show\\b/i": true,

        "npm run build": true,
        "/^npm\\stest\\s--.+/i": true, 
        "/^npm(?:\\.cmd)?\\s+test\\b/i": true,
        "/^npx(?:\\.cmd)?\\s+vitest\\s+run\\b/": true,
        "/^npm\\stest\\s.*/i": true,

        "/^node(?:\\.exe)?\\s+--check\\b/": true
    }
}
